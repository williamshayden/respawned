# Seed data
QUOTES_FILENAME=quotes.json
EVENTS_FILENAME=events.jsonl

# Application database (host-facing values)
DB_IMAGE=postgres:16-alpine
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=respawned
DB_USER=respawned
DB_PASSWORD=change-me

# LiteLLM proxy (optional until running `respawned review`)
LITELLM_PROXY_PORT=4000
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MODEL_ALIAS=respawned-default
LITELLM_MASTER_KEY=sk-local-master-key
LITELLM_SALT_KEY=sk-local-salt-key-change-me-000000
STORE_MODEL_IN_DB=True
ANTHROPIC_API_KEY=replace-with-your-anthropic-key

# LiteLLM usage database
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=change-me
