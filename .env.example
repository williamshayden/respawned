# Application database (host-facing values)
BIND_HOST=127.0.0.1
DB_IMAGE=postgres:16-alpine
DB_DATA_MOUNT=/var/lib/postgresql/data
# For PostgreSQL 18, keep DB_IMAGE=postgres:18-alpine and use:
# DB_DATA_MOUNT=/var/lib/postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=respawned
DB_USER=respawned
DB_PASSWORD=change-me
APP_PORT=8000

# Optional operator-only HTTP processing. Empty keeps POST /v1/process disabled.
# Set a separate random token and send it as a Bearer credential when enabling.
RESPAWNED_PROCESS_TOKEN=
# Optional reviewer Bearer credential for serve, Docker, or API scripts.
# Local `respawned ui` connects through a browser session without this token.
RESPAWNED_REVIEW_TOKEN=
# Allow a browser UI hosted elsewhere to connect to this `serve`/Docker engine.
# Exact origins only, comma-separated; no trailing slash, path, or wildcard.
# Example: RESPAWNED_UI_ORIGINS=http://127.0.0.1:8000,https://respawned.example.com
# Keep the reviewer token enabled. This does not grant cookie or API authority.
# Local `respawned ui` sessions always refuse cross-origin browser access.
RESPAWNED_UI_ORIGINS=
# The server serves the packaged browser UI by default, without Node.js.
# Optional absolute directory override for a separate frontend build:
# RESPAWNED_UI_DIST=/absolute/path/to/web/dist
# To run only the API, set RESPAWNED_UI_DIST=off.
# Optional host process policy file; otherwise the bundled human-review policy.
# RESPAWNED_POLICY_PATH=/absolute/path/to/policy.yaml
# Compose custom policies need a read-only mount and RESPAWNED_POLICY_PATH in an override.

# Drafting backend fallback when no model settings have been saved in Setup.
# Choose openai_compatible (default) or codex_cli (existing ChatGPT CLI login).
RESPAWNED_MODEL_BACKEND=openai_compatible
# Optional Codex executable if not on PATH. Install/login on the server first.
# RESPAWNED_CODEX_BIN=/absolute/path/to/codex
# Optional existing scratch directory. Windows Codex from WSL requires one on /mnt/<drive>.
# RESPAWNED_CODEX_SCRATCH_DIR=/absolute/path/to/scratch
# Empty uses the CLI default; an explicit model must be available to your login.
RESPAWNED_CODEX_MODEL=
RESPAWNED_CODEX_TIMEOUT_SECONDS=120

# LiteLLM proxy (optional until drafting through review or POST /v1/process)
LITELLM_PROXY_PORT=4000
# Host CLI/server URL:
LITELLM_PROXY_URL=http://localhost:4000
# App container URL; the optional litellm profile provides this service.
APP_LITELLM_PROXY_URL=http://litellm:4000
LITELLM_MODEL_ALIAS=respawned-default
# Per-network-operation SDK timeout; SDK automatic retries are disabled.
LITELLM_TIMEOUT_SECONDS=60
LITELLM_MASTER_KEY=sk-local-master-key
# Optional dedicated credential for a direct or local OpenAI-compatible backend.
# In Setup, select RESPAWNED_MODEL_API_KEY after setting this on the server.
# The browser saves only the variable name, never the credential itself.
RESPAWNED_MODEL_API_KEY=
LITELLM_SALT_KEY=sk-local-salt-key-change-me-000000
STORE_MODEL_IN_DB=True
LITELLM_UPSTREAM_MODEL=anthropic/claude-sonnet-4-5-20250929
LITELLM_UPSTREAM_API_KEY=replace-with-your-provider-key

# LiteLLM usage database
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=change-me
